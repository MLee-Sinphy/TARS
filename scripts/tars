#!/usr/bin/env bash

TARS_HOME="$HOME/AI/TARS"

source "$TARS_HOME/lib/model_manager.sh"


if [[ "$1" == "models" ]]; then
    list_models
    exit 0
fi


if [[ -n "$1" ]]; then
    MODEL=$(resolve_model "$1")
else
    MODEL=$(get_current_model)
fi


echo "Usando modelo: $MODEL"

hermes chat -m "$MODEL"
